    <!-- About -->
    <string name="about_title">关于应用</string>
    <string name="about_version">版本 %1$s</string>
    <string name="about_intro">「墨记报告」是一款用于记录学习、工作与生活报告的本地应用。界面简洁，数据保存在手机本地，打开即可书写。</string>
    <string name="about_features_title">功能介绍</string>
    <string name="about_features">· 分类记录：学习、工作、生活、其他\n· 快速检索：按标题或正文搜索\n· 分类筛选：一键查看同类报告\n· 详情查看：编辑、分享、删除\n· 本地存储：无需联网，隐私安全</string>
    <string name="about_tech_title">技术要点</string>
    <string name="about_tech">· Activity 页面跳转与 Intent 数据传递\n· RecyclerView 列表展示与事件处理\n· SQLite（SQLiteOpenHelper）数据持久化\n· SharedPreferences 保存登录信息\n· Material Design 3 组件与主题\n· 沉浸式状态栏与窗口 Insets 适配</string>
    <string name="about_usage_title">使用说明</string>
    <string name="about_usage">1. 在登录页输入用户名与密码进入主页\n2. 点击右下角 + 新建一篇报告\n3. 选择分类，填写标题与正文后保存\n4. 点击列表项查看详情，可编辑或分享\n5. 长按列表项可快速删除报告</string>
    <string name="about_course_title">关于本作业</string>
    <string name="about_course">本应用为《Android 移动开发基础案例教程》课程阶段作业，综合运用了 Activity、RecyclerView、SQLite、SharedPreferences、Intent 与 Material Design 等基础知识点。</string>
    <string name="about_footer">© 2026 墨记报告 · 课程阶段作业</string>
